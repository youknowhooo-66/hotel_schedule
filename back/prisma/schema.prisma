// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMIN
  USER
}

model Usuario {
  id                Int         @id @default(autoincrement())
  nome              String
  email             String      @unique
  senha             String
  ativo             Boolean     @default(true)
  tipoUsuario       TipoUsuario @default(USER)
  resetToken        String?
  resetTokenExpires DateTime?
  
  auditLogs         AuditLog[]
  bookingsCreated   Booking[]   @relation("CreatedBy")

  @@map("usuario")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RoomCategory {
  SIMPLES
  DUPLO
  SUITE
}

model Room {
  id           Int          @id @default(autoincrement())
  number       String       @unique
  category     RoomCategory
  basePrice    Float
  status       RoomStatus   @default(AVAILABLE)
  bookings     Booking[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("room")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model Booking {
  id            Int           @id @default(autoincrement())
  guestName     String
  guestEmail    String
  checkIn       DateTime
  checkOut      DateTime
  status        BookingStatus @default(PENDING)
  totalPrice    Float
  
  room          Room          @relation(fields: [roomId], references: [id])
  roomId        Int
  
  createdBy     Usuario       @relation("CreatedBy", fields: [createdById], references: [id])
  createdById   Int

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("booking")
}

model PricingRule {
  id              Int      @id @default(autoincrement())
  description     String
  startDate       DateTime
  endDate         DateTime
  priceMultiplier Float?   @default(1.0)
  fixedPrice      Float?
  category        RoomCategory? // If null, applies to all
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pricing_rule")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g., "CREATE_BOOKING", "UPDATE_ROOM"
  entity    String   // e.g., "Booking", "Room"
  entityId  Int
  details   String?  // JSON string or description
  
  user      Usuario  @relation(fields: [userId], references: [id])
  userId    Int
  
  createdAt DateTime @default(now())

  @@map("audit_log")
}
